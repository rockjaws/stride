<Window x:Class="client.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:client.Presentation.Views"
		xmlns:userControls="clr-namespace:client.Presentation.UserControls"
		xmlns:viewModels="clr-namespace:client.Presentation.ViewModels"
		xmlns:commands="clr-namespace:client.Presentation.Commands"
        mc:Ignorable="d"
        Title="Stride" Height="1300" Width="2000" WindowState="Maximized" WindowStyle="None">


		<Window.Resources>
			<commands:QuitCommand x:Key="QuitCommand" />
            <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Height" Value="46"/>
                <Setter Property="Margin" Value="12 4"/>
                <Setter Property="Padding" Value="14 0"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF2F7"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#DBEAFE"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#93C5FD"/>
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="44"/>
                <Setter Property="Margin" Value="12 0 12 10"/>
                <Setter Property="Padding" Value="14 0"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#0F172A"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimarySidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="#2563EB"/>
                <Setter Property="BorderBrush" Value="#2563EB"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1D4ED8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

			<DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
				<userControls:DashboardUserControl/>
			</DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:ProjectViewModel}">
				<userControls:ProjectUserControl/>
			</DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TaskViewModel}">
            <userControls:TaskUserControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ChatViewModel}">
            <userControls:ChatUserControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ArchiveViewModel}">
            <userControls:ArchiveUserControl/>
        </DataTemplate>
    </Window.Resources>

		<Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
		<Border Grid.Column="0"
                Background="#F8FAFC"
                BorderBrush="#D6DCE5"
                BorderThickness="0 0 1 0">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Margin="0 16 0 0">
                <RadioButton x:Name="DashboardButton"
							 Content="Dashboard"
							 GroupName="SideMenu"
							 Command="{Binding ChangeViewCommand}"
							 CommandParameter="{Binding DashboardViewModel}"
							 IsChecked="{Binding IsDashboardSelected, Mode=OneWay}"
							 Style="{StaticResource NavRadioButtonStyle}"/>
                <RadioButton x:Name="ProjectButton"
							 Content="Projects"
							 GroupName="SideMenu"
							 Command="{Binding ChangeViewCommand}"
							 CommandParameter="{Binding ProjectViewModel}"
                             IsChecked="{Binding IsProjectsSelected, Mode=OneWay}"
							 Style="{StaticResource NavRadioButtonStyle}"/>
                <RadioButton x:Name="TaskButton"
							 Content="Tasks"
							 GroupName="SideMenu"
							 Command="{Binding ChangeViewCommand}"
							 CommandParameter="{Binding TaskViewModel}"
                             IsChecked="{Binding IsTasksSelected, Mode=OneWay}"
							 Style="{StaticResource NavRadioButtonStyle}"/>
                <RadioButton x:Name="ChatButton"
							 Content="Chats"
							 GroupName="SideMenu"
							 Command="{Binding ChangeViewCommand}"
							 CommandParameter="{Binding ChatViewModel}"
                             IsChecked="{Binding IsChatsSelected, Mode=OneWay}"
							 Style="{StaticResource NavRadioButtonStyle}"/>
                <RadioButton x:Name="ArchiveButton"
						     Content="Archive"
						     GroupName="SideMenu"
						     Command="{Binding ChangeViewCommand}"
						     CommandParameter="{Binding ArchiveViewModel}"
                             IsChecked="{Binding IsArchiveSelected, Mode=OneWay}"
						     Style="{StaticResource NavRadioButtonStyle}"/>
                </StackPanel>

			<StackPanel Grid.Row="1" Margin="0 0 0 12">
				<Button x:Name="NewProjectButton"
						Content="New Project"
						Command="{Binding CreateNewProjectCommand}"
						Style="{StaticResource PrimarySidebarButtonStyle}"/>
				<Button x:Name="QuitButton"
						Content="Quit"
						Command="{StaticResource QuitCommand}"
						Style="{StaticResource SidebarButtonStyle}"/>
			</StackPanel>
		</Grid>
        </Border>
		<ContentControl Grid.Column="1" Content="{Binding CurrentView}" />

        <Border Grid.ColumnSpan="2"
                Width="360"
                Padding="16 12"
                Margin="0 20 24 0"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="100"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Notification"
                           Foreground="#BFDBFE"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ToastText}"
                           Foreground="#FFFFFF"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0 4 0 0"/>
            </StackPanel>
        </Border>
		</Grid>
		</Window>
