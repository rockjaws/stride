<UserControl x:Class="client.Presentation.UserControls.DashboardUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:client.Presentation.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="950"
             Background="#F1F5F9">

    <UserControl.Resources>
        <!-- MODERN CARD STYLE -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- CLEAN DATAGRID HEADERS -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- MODERN CALENDAR OVERRIDES -->
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                    -->
        <!-- ========================================================= -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="6,4,6,20">
            <TextBlock Text="Dashboard"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>
        </StackPanel>

        <!-- ========================================================= -->
        <!-- PROJECT OVERVIEW (UPDATED TO MATCH KANBAN)                -->
        <!-- ========================================================= -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="My Task Overview"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>

                <!-- Changed Columns to 4 to match Kanban states -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,24,0,0">

                    <!-- BACKLOG -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Backlog" Foreground="#64748B" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BacklogCount}" FontSize="32" FontWeight="Bold" Foreground="#475569" Margin="0,4" HorizontalAlignment="Center"/>
                        <ProgressBar Value="40" Height="6" Width="80" Foreground="#94A3B8" Background="#E2E8F0" BorderThickness="0"/>
                    </StackPanel>

                    <!-- IN PROGRESS -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="In Progress" Foreground="#2563EB" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding InProgressCount}" FontSize="32" FontWeight="Bold" Foreground="#2563EB" Margin="0,4" HorizontalAlignment="Center"/>
                        <ProgressBar Value="65" Height="6" Width="80" Foreground="#3B82F6" Background="#DBEAFE" BorderThickness="0"/>
                    </StackPanel>

                    <!-- IN REVIEW (New State!) -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="In Review" Foreground="#D97706" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding InReviewCount}" FontSize="32" FontWeight="Bold" Foreground="#D97706" Margin="0,4" HorizontalAlignment="Center"/>
                        <ProgressBar Value="85" Height="6" Width="80" Foreground="#F59E0B" Background="#FEF3C7" BorderThickness="0"/>
                    </StackPanel>

                    <!-- DONE -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Done" Foreground="#16A34A" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding FinishedCount}" FontSize="32" FontWeight="Bold" Foreground="#16A34A" Margin="0,4" HorizontalAlignment="Center"/>
                        <ProgressBar Value="100" Height="6" Width="80" Foreground="#22C55E" Background="#DCFCE7" BorderThickness="0"/>
                    </StackPanel>

                </UniformGrid>
            </Grid>
        </Border>
        <!-- ========================================================= -->
        <!-- ACTIVITY                                                  -->
        <!-- ========================================================= -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
            <DockPanel>
                <TextBlock Text="Latest Activity"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,20"/>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E" Margin="0,5,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Username completed 'Login API'" FontSize="13" FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap"/>
                            <TextBlock Text="10m ago" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="8" Height="8" CornerRadius="4" Background="#3B82F6" Margin="0,5,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Username commented on #102" FontSize="13" FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap"/>
                            <TextBlock Text="1h ago" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- TASK TABLE                                                -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
            <DockPanel>
                <TextBlock Text="My Upcoming Tasks"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,16"/>

                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="40"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          ItemsSource="{Binding UpcomingTasks}"
                          Sorting="DataGrid_OnSorting">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Task" Width="2*" Binding="{Binding Title}" CanUserSort="False"/>
                        <DataGridTextColumn Header="Due Date" Width="1*" Binding="{Binding Deadline}"/>
                        <DataGridTextColumn Header="Priority" Width="1*" Binding="{Binding Priority}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- CALENDAR CARD                                             -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Project Calendar"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                </Grid>
  <local:ProjectCalendarUserControl
    DataContext="{Binding CalendarViewModel}"
    Margin="0,6,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
