<UserControl x:Class="client.Presentation.UserControls.ProjectUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:client.Presentation.UserControls"
             xmlns:domain="clr-namespace:client.Domain.Enum"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="14 0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8 0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KanbanColumnStyle" TargetType="Border">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
        </Style>

        <Style x:Key="TaskCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TaskCardMetaStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10 0 8 0"/>
        </Style>

        <Style x:Key="TaskIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskDangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TaskIconButtonStyle}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
        </Style>

        <Style x:Key="PriorityPickerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10 0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PickerButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickerButtonBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="PickerButtonBorder" Property="BorderBrush" Value="#BFDBFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PickerButtonBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ProjectRoot"
          Background="#F1F5F9"
          Focusable="True"
          PreviewMouseDown="ProjectRoot_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0 0 0 1"/>

        <Grid Grid.Row="0" Margin="12 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Style="{StaticResource ProjectComboBoxStyle}"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding ListOfProjects}"
                      SelectedItem="{Binding SelectedProject}"
                      DisplayMemberPath="Title"/>

            <Button Grid.Column="1"
                    Style="{StaticResource ToolbarButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="New Task +"
                    Command="{Binding CreateNewTaskCommand}"/>
        </Grid>

        <!-- Kanban Columns -->
        <Grid Grid.Row="1" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Backlog -->
            <Border Grid.Column="0" Style="{StaticResource KanbanColumnStyle}" AllowDrop="True" DragOver="Column_DragOver" Drop="Column_Drop" Tag="{x:Static domain:TaskProgress.Backlog}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Backlog" Style="{StaticResource ColumnHeaderTextStyle}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding BacklogTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#64748B" BorderThickness="1" CornerRadius="6" Margin="0 0 0 8" Padding="10" Cursor="Hand" PreviewMouseMove="TaskCard_PreviewMouseMove" MouseLeftButtonDown="TaskCard_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource TaskCardTitleStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Priority, StringFormat='Priority: {0}'}" Style="{StaticResource TaskCardMetaStyle}"/>
                                            <Button Grid.Column="2" Content="↑" Style="{StaticResource TaskIconButtonStyle}" Tag="{Binding}" PreviewMouseLeftButtonDown="ChangePriority_Click" Margin="0 0 6 0"/>
                                            <Button Grid.Column="3" Content="🗑️" Style="{StaticResource TaskDangerButtonStyle}" Tag="{Binding}" PreviewMouseLeftButtonDown="DeleteTask_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- In Progress -->
            <Border Grid.Column="1" Style="{StaticResource KanbanColumnStyle}" AllowDrop="True" DragOver="Column_DragOver" Drop="Column_Drop" Tag="{x:Static domain:TaskProgress.InProgress}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="In Progress" Style="{StaticResource ColumnHeaderTextStyle}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding InProgressTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFBEB" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Margin="0 0 0 8" Padding="10" Cursor="Hand" PreviewMouseMove="TaskCard_PreviewMouseMove" MouseLeftButtonDown="TaskCard_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource TaskCardTitleStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Priority, StringFormat='Priority: {0}'}" Style="{StaticResource TaskCardMetaStyle}"/>
                                            <Button Grid.Column="2" Content="↑" Style="{StaticResource TaskIconButtonStyle}" Tag="{Binding}" PreviewMouseLeftButtonDown="ChangePriority_Click" Margin="0 0 6 0"/>
                                            <Button Grid.Column="3" Content="🗑️" Style="{StaticResource TaskDangerButtonStyle}" Tag="{Binding}" PreviewMouseLeftButtonDown="DeleteTask_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- In Review -->
            <Border Grid.Column="2" Style="{StaticResource KanbanColumnStyle}" AllowDrop="True" DragOver="Column_DragOver" Drop="Column_Drop" Tag="{x:Static domain:TaskProgress.Review}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="In Review" Style="{StaticResource ColumnHeaderTextStyle}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding InReviewTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F3FF" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="6" Margin="0 0 0 8" Padding="10" Cursor="Hand" PreviewMouseMove="TaskCard_PreviewMouseMove" MouseLeftButtonDown="TaskCard_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource TaskCardTitleStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Priority, StringFormat='Priority: {0}'}" Style="{StaticResource TaskCardMetaStyle}"/>
                                            <Button Grid.Column="2" Content="↑" Style="{StaticResource TaskIconButtonStyle}" Tag="{Binding}" PreviewMouseLeftButtonDown="ChangePriority_Click" Margin="0 0 6 0"/>
                                            <Button Grid.Column="3" Content="🗑️" Style="{StaticResource TaskDangerButtonStyle}" Tag="{Binding}" PreviewMouseLeftButtonDown="DeleteTask_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Done -->
            <Border Grid.Column="3" Style="{StaticResource KanbanColumnStyle}" AllowDrop="True" DragOver="Column_DragOver" Drop="Column_Drop" Tag="{x:Static domain:TaskProgress.Done}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Done" Style="{StaticResource ColumnHeaderTextStyle}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FinishedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F0FDF4" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="6" Margin="0 0 0 8" Padding="10" Cursor="Hand" PreviewMouseMove="TaskCard_PreviewMouseMove" MouseLeftButtonDown="TaskCard_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource TaskCardTitleStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Priority, StringFormat='Priority: {0}'}" Style="{StaticResource TaskCardMetaStyle}"/>
                                            <Button Grid.Column="2" Content="↑" Style="{StaticResource TaskIconButtonStyle}" Tag="{Binding}" PreviewMouseLeftButtonDown="ChangePriority_Click" Margin="0 0 6 0"/>
                                            <Button Grid.Column="3" Content="🗑️" Style="{StaticResource TaskDangerButtonStyle}" Tag="{Binding}" PreviewMouseLeftButtonDown="DeleteTask_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Project Feed -->
        <Border Grid.Row="2"
                Margin="12 4 12 12"
                Padding="14"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0 0 0 10">
                    <TextBlock Text="Project Feed"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Recent changes in the selected project"
                               Foreground="#64748B"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border BorderBrush="#E2E8F0"
                                BorderThickness="0 0 0 1"
                                Padding="0 8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Task updated"
                                           Foreground="#0F172A"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="A task title, priority, progress, or deadline changed."
                                           Foreground="#334155"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           Text="Just now"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#E2E8F0"
                                BorderThickness="0 0 0 1"
                                Padding="0 8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Task moved"
                                           Foreground="#0F172A"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="A task moved between kanban columns."
                                           Foreground="#334155"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           Text="Pending data"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Padding="0 8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Task deleted"
                                           Foreground="#0F172A"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="Deleted tasks will appear here once feed data is wired."
                                           Foreground="#334155"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           Text="Pending data"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="PriorityPicker"
                Grid.RowSpan="3"
                Panel.ZIndex="50"
                Width="116"
                Padding="4"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Focusable="False">
            <Border.Effect>
                <DropShadowEffect Color="#64748B"
                                  BlurRadius="12"
                                  ShadowDepth="2"
                                  Opacity="0.18"/>
            </Border.Effect>
            <StackPanel>
                <Button Content="Low"
                        Style="{StaticResource PriorityPickerButtonStyle}"
                        Click="Priority_Low_Click"/>
                <Button Content="Medium"
                        Style="{StaticResource PriorityPickerButtonStyle}"
                        Click="Priority_Medium_Click"/>
                <Button Content="High"
                        Style="{StaticResource PriorityPickerButtonStyle}"
                        Click="Priority_High_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
